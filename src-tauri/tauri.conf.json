{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RingRing",
  "version": "0.1.2",
  "identifier": "com.zacostudio.ringring",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5185",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "zacostudio",
    "copyright": "Copyright © 2026 zacostudio. MIT License.",
    "category": "Utility",
    "shortDescription": "A ring menu around the cursor",
    "longDescription": "RingRing shows a round menu around the cursor over any app. Hold a shortcut, move toward a slot and release to run it.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "resources": {
      "resources/ko.lproj/InfoPlist.strings": "ko.lproj/InfoPlist.strings",
      "resources/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "resources/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings"
    }
  }
}
