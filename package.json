{
  "name": "ringring",
  "version": "0.1.0",
  "description": "RingRing — a ring menu around the cursor, for macOS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "typecheck": "bunx tsc --noEmit -p tsconfig.app.json",
    "lint": "bunx biome check src",
    "lint:fix": "bunx biome check --write src",
    "lint:sh": "bunx shellcheck scripts/*.sh",
    "test": "bun test src/",
    "tauri:dev": "cargo tauri dev --config src-tauri/tauri.dev.conf.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@swc/plugin-emotion": "14.15.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "shellcheck": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "trustedDependencies": [
    "@swc/core",
    "shellcheck"
  ],
  "overrides": {
    "@swc/core": "1.15.47"
  }
}
